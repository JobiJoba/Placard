# Copy to .env and adjust. docker compose reads this file automatically.

# Database password used by the bundled Postgres container.
# Required. Generate with:
#   openssl rand -hex 24
# Set it before the first start: the database volume keeps the initial password.
POSTGRES_PASSWORD=

# Signs session cookies. Required, at least 32 characters. Generate with:
#   openssl rand -base64 32
# Changing it signs everyone out.
BETTER_AUTH_SECRET=

# Public URL where Placard is reachable. Sign-in only works from this origin,
# and invite links point here.
PUBLIC_URL=http://localhost:3000

# Host port to expose the app on.
PLACARD_PORT=3000

# Published Compose only: use 127.0.0.1 for local access; default is all interfaces.
# PLACARD_BIND_ADDRESS=127.0.0.1

# Optional bundled Caddy HTTPS (installer sets this with --https-domain / -HttpsDomain).
# Requires the HTTPS Compose overlay and Caddyfile. PUBLIC_URL must be https://this-domain.
# PLACARD_DOMAIN=placard.example.com

# Prebuilt image when using compose.ghcr.yaml (ignored by the source-build compose.yaml).
# Examples:
#   ghcr.io/jobijoba/placard:0.1.0     # pin a release (production)
#   ghcr.io/jobijoba/placard:latest    # latest stable release
#   ghcr.io/jobijoba/placard:nightly   # tip of main after CI (default)
# PLACARD_IMAGE=ghcr.io/jobijoba/placard:nightly

# Optional: Google Maps / Places API key. Can also be set later in the admin settings.
GOOGLE_MAPS_API_KEY=

# Set to false to disable the MCP endpoint entirely.
MCP_ENABLED=true

# Prebuilt plugin zip installs (Compose mounts a named volume at /data/modules).
# PLACARD_MODULES_DIR=/data/modules

# Only needed when running outside docker compose / Aspire (pnpm start, pnpm worker, e2e).
# DATABASE_URL=postgres://placard:change-me@localhost:5432/placard
