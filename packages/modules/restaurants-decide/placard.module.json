{
  "id": "restaurants.decide",
  "name": "Decide",
  "version": "0.2.0",
  "description": "Spin a restaurant from your library — open tonight, near you, or surprise me.",
  "permissions": ["places.read", "search.query"],
  "nav": [
    {
      "path": "/m/restaurants.decide",
      "label": "Decide",
      "slot": "primary"
    }
  ],
  "source": "bundled",
  "packageName": "@placard/module-restaurants-decide",
  "sdkVersion": "0.1.0",
  "serverEntry": "./server/index.js",
  "webEntry": "./web/index.js",
  "icon": "/module-covers/decide.svg",
  "cover": "/module-covers/decide.svg",
  "webRoutes": [
    {
      "path": "/m/restaurants.decide",
      "exportName": "DecidePage"
    }
  ],
  "actions": [
    {
      "id": "open",
      "label": "Decide where to eat",
      "keywords": "spin wheel dinner restaurant tonight",
      "path": "/m/restaurants.decide"
    }
  ],
  "mcpTools": [
    {
      "name": "decide_restaurant",
      "title": "Decide restaurant",
      "description": "Pick one restaurant from your library (open tonight, list/tag/radius, optional avoid-recent). Same rules as the Decide wheel."
    }
  ]
}
