{
  "name": "@placard/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "worker": "node src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.6",
    "@effect/sql-pg": "4.0.6",
    "@placard/domain": "workspace:*",
    "better-auth": "1.7.13",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.0.6",
    "fflate": "^0.8.3",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.6",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/sharp": "^0.32.0",
    "drizzle-kit": "1.0.0-rc.5",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
