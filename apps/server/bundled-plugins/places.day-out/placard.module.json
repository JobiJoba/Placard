{
  "id": "places.day-out",
  "name": "Day Out",
  "version": "0.1.1",
  "description": "Plan a day around a saved place, with coffee, sightseeing and dinner along the way.",
  "permissions": [
    "places.read",
    "search.query"
  ],
  "nav": [
    {
      "path": "/m/places.day-out",
      "label": "Day Out",
      "slot": "more",
      "mobileIcon": "route"
    }
  ],
  "source": "bundled",
  "sdkVersion": "1.0.0",
  "requiredCapabilities": [
    "persistent-data"
  ],
  "serverEntry": "./server/index.js",
  "webEntry": "./web/index.js",
  "icon": "web/assets/icon.svg",
  "webRoutes": [
    {
      "path": "/m/places.day-out",
      "exportName": "DayOutPage"
    }
  ],
  "actions": [
    {
      "id": "open",
      "label": "Plan a Day Out",
      "keywords": "outing nearby itinerary",
      "path": "/m/places.day-out"
    }
  ],
  "mcpTools": [
    {
      "name": "suggest_outing",
      "description": "suggest outing"
    },
    {
      "name": "list_outings",
      "description": "list outings"
    },
    {
      "name": "get_outing",
      "description": "get outing"
    },
    {
      "name": "save_outing",
      "description": "save outing"
    },
    {
      "name": "delete_outing",
      "description": "delete outing"
    }
  ],
  "cover": "web/assets/marketplace-cover.svg"
}
