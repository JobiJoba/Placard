{
  "id": "places.board",
  "name": "Board",
  "version": "0.2.2",
  "description": "Turn your favorite places into a travel board you can arrange, preview and print.",
  "permissions": [
    "places.read",
    "search.query"
  ],
  "nav": [
    {
      "path": "/m/places.board",
      "label": "Board",
      "slot": "more",
      "mobileIcon": "dices"
    }
  ],
  "source": "bundled",
  "sdkVersion": "1.0.0",
  "requiredCapabilities": [
    "persistent-data"
  ],
  "serverEntry": "./server/index.js",
  "webEntry": "./web/index.js",
  "icon": "web/assets/icon.svg",
  "webRoutes": [
    {
      "path": "/m/places.board",
      "exportName": "BoardPage"
    }
  ],
  "actions": [
    {
      "id": "open",
      "label": "Open Board Designer",
      "keywords": "board travel print monopoly",
      "path": "/m/places.board"
    }
  ],
  "cover": "web/assets/marketplace-cover.svg"
}
