@@ -0,0 +1,19 @@
+import { renderToString } from "react-dom/server"
+import { StaticRouter } from "react-router"
+import { App } from "./App"
+import { listPublishedSlugs } from "./docs/catalog"
+
+export { pageMetadata, SITE_ORIGIN } from "./metadata"
+export const routes = [
+  "/",
+  "/plugins",
+  "/docs",
+  ...listPublishedSlugs().map((slug) => `/docs/${slug}`),
+]
+export function render(path: string) {
+  return renderToString(
+    <StaticRouter location={path}>
+      <App />
+    </StaticRouter>,
+  )
+}
diff --git a/apps/site/src/metadata.ts b/apps/site/src/metadata.ts
new file mode 100644
index 0000000..96381d4
--- /dev/null
+++ b/apps/site/src/metadata.ts
@@ -0,0 +1,24 @@
+import { getDocMeta } from "./docs/catalog"
+
+export const SITE_ORIGIN = "https://placard.fyi"
+export function pageMetadata(pathname: string) {
+  const path = pathname.replace(/\/$/, "") || "/"
+  const doc = path.startsWith("/docs/") ? getDocMeta(path.slice(6)) : null
+  const title = doc
+    ? `${doc.title} · Placard`
+    : path === "/docs"
+      ? "Documentation · Placard"
+      : path === "/plugins"
+        ? "Plugins · Placard"
+        : path === "/"
+          ? "Placard — Good places. Worth keeping."
+          : "Page not found · Placard"
+  const description =
+    doc?.summary ??
+    (path === "/docs"
+      ? "Install, run, and extend your self-hosted Placard library."
+      : path === "/plugins"
+        ? "Discover plugins for your Placard library."
+        : "A self-hosted library for places worth keeping. Import saved places, organize notes and photos, and share with your household.")
+  return { path, title, description }
+}
